{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "description": "SVG command-line editor for the software design project",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "precli": "npm run build",
    "cli": "node dist/bootstrap/Main.js",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
